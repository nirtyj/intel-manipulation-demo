<?xml version="1.0"?>
<!-- can_flip: an upside-down soup can on a green pad, a tall wall, a blue destination pad.
     The arm (franka_panda) is attached at robot_mount by Intel's MuJoCo plugin:
       physicalai-mujoco start --profile franka_panda --model scenes/can_flip/scene.xml
     World frame: x forward from the robot base, y to its left, z up; the floor plane is the tabletop. -->
<mujoco model="can_flip">
  <compiler angle="radian" autolimits="true"/>
  <!-- Same solver settings as Intel's single_pick_place, tuned there for the Franka Hand's squeeze. -->
  <option integrator="implicitfast" timestep="0.002" cone="elliptic" iterations="10" ls_iterations="50" impratio="10"/>
  <visual>
    <headlight diffuse="0.0 0.0 0.0" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <quality shadowsize="8192" offsamples="8"/>
    <map znear="0.01" zfar="10"/>
  </visual>
  <default>
    <geom condim="4"/>
  </default>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.82 0.83 0.85" rgb2="0.55 0.56 0.58" width="512" height="3072"/>
    <texture type="2d" name="table" builtin="flat" rgb1="0.72 0.73 0.75" width="64" height="64"/>
    <material name="table" texture="table" specular="0.1"/>
    <material name="can_red" rgba="0.78 0.10 0.10 1" specular="0.3"/>
    <material name="can_white" rgba="0.93 0.92 0.88 1" specular="0.3"/>
    <material name="can_metal" rgba="0.70 0.70 0.72 1" specular="0.8" shininess="0.8"/>
  </asset>
  <worldbody>
    <light pos="0.5 0.6 2.5" dir="-0.1 -0.2 -1" directional="false" cutoff="40" diffuse="0.55 0.55 0.55"/>
    <light pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.35 0.35 0.35" castshadow="false"/>
    <geom name="table" type="plane" size="1.2 1.0 0.01" pos="0.35 0 0" material="table" condim="3" friction="0.8 0.005 0.0001"/>

    <!-- pick pad, wall, place pad -->
    <geom name="pad_green" type="box" size="0.06 0.06 0.0015" pos="0.48 0.24 0.0015" rgba="0.15 0.75 0.30 1" contype="0" conaffinity="0"/>
    <geom name="pad_blue" type="box" size="0.06 0.06 0.0015" pos="0.48 -0.24 0.0015" rgba="0.25 0.50 0.90 1" contype="0" conaffinity="0"/>
    <geom name="wall" type="box" size="0.03 0.03 0.16" pos="0.50 0.0 0.16" rgba="0.85 0.33 0.10 1" friction="0.8 0.005 0.0001"/>

    <!-- YCB-sized tomato soup can (66 mm x 101 mm, 0.35 kg), standing bottom-up: its red half is at the bottom.
         One collision cylinder; the colour bands and lids are visual only. -->
    <body name="can" pos="0.48 0.24 0.0505" quat="0 1 0 0">
      <joint type="free" name="can:joint" damping="0.0005" frictionloss="0" armature="0"/>
      <geom name="can_collision" type="cylinder" size="0.033 0.0505" mass="0.35" rgba="0 0 0 0"
            friction="1.2 0.01 0.0002" solref="0.004 1" solimp="0.95 0.99 0.001"/>
      <geom name="can_label_red" type="cylinder" size="0.0332 0.025" pos="0 0 0.0255" material="can_red" contype="0" conaffinity="0" mass="0"/>
      <geom name="can_label_white" type="cylinder" size="0.0332 0.025" pos="0 0 -0.0255" material="can_white" contype="0" conaffinity="0" mass="0"/>
      <geom name="can_lid" type="cylinder" size="0.031 0.0008" pos="0 0 0.0505" material="can_metal" contype="0" conaffinity="0" mass="0"/>
      <geom name="can_base" type="cylinder" size="0.031 0.0008" pos="0 0 -0.0505" material="can_metal" contype="0" conaffinity="0" mass="0"/>
      <site name="can_top" pos="0 0 0.0505" size="0.004" rgba="1 1 0 0"/>
    </body>

    <frame name="robot_mount"/>

    <!-- Cameras. overview: the presentation view. scene_cam_0 / scene_cam_1: fixed RGB-D views for perception,
         like the two scene cameras in the reference video. Cameras look down their -z axis. -->
    <camera name="overview" pos="1.35 0.85 0.95" xyaxes="-0.667 0.745 0.000 -0.396 -0.354 0.847" fovy="50"/>
    <camera name="scene_cam_0" pos="0.95 0.4 0.5" xyaxes="-0.512 0.859 0.000 -0.546 -0.325 0.772" fovy="55"/>
    <camera name="scene_cam_1" pos="0.95 -0.4 0.5" xyaxes="0.512 0.859 -0.000 -0.546 0.325 0.772" fovy="55"/>
  </worldbody>
</mujoco>
