+    def _set_instruction(self, obj: str, bucket: str) -> None:
+        """Give bucket_sort a new instruction in place: same layout, and a new demonstrator episode."""
+        from physicalai_mujoco_plugin.bucket_sort import BucketSortTask, Instruction  # noqa: PLC0415
+
+        task = self._sim.on_reset if self._sim is not None else None
+        if not isinstance(task, BucketSortTask):
+            logger.warning("Scene '{}' takes no instruction", self._current_scene_id)
+            return
+        state = task.evaluate(self._sim.model, self._sim.data)  # type: ignore[union-attr]
+        task.settled = frozenset(name for name, color in state.in_bucket.items() if color is not None and name != obj)
+        task.instruction = Instruction(object=obj, bucket=bucket)
+        task.reset_count += 1  # a new value starts a new demonstrator episode without moving anything
+        logger.info("Instruction set: {}", task.instruction.canonical_text)
+
     def _init_episode_auto_reset(self) -> None:
