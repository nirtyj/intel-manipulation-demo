+def camera_intrinsics(model: object, camera_id: int, width: int, height: int) -> np.ndarray:
+    """Pinhole matrix of a MuJoCo camera (vertical ``fovy``, square pixels, centred principal point)."""
+    fy = 0.5 * height / np.tan(np.radians(float(model.cam_fovy[camera_id])) / 2.0)
+    return np.array([[fy, 0.0, width / 2.0], [0.0, fy, height / 2.0], [0.0, 0.0, 1.0]])
+
+
+def camera_pose_cv(data: object, camera_id: int) -> np.ndarray:
+    """World-from-camera transform in the OpenCV convention (x right, y down, z forward).
+
+    A MuJoCo camera looks down its -z axis with y up, so flip its y and z axes.
+    """
+    pose = np.eye(4)
+    pose[:3, :3] = np.asarray(data.cam_xmat[camera_id]).reshape(3, 3) @ np.diag([1.0, -1.0, -1.0])
+    pose[:3, 3] = np.asarray(data.cam_xpos[camera_id])
+    return pose
+
